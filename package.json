{
  "name": "budget-aware-mcp",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "Model-agnostic code memory MCP server. Budget-aware graph retrieval for AI agents — sub-millisecond queries, token budgeting, no embeddings, no API keys. Built on CodeGraphContext for 155-language tree-sitter indexing.",
  "main": "dist/index.js",
  "bin": {
    "budget-aware-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx test/test.ts",
    "bench": "tsx bench/bench_inprocess.ts",
    "bench:compare": "tsx bench/fair_benchmark.ts"
  },
  "keywords": [
    "mcp",
    "code-graph",
    "ai-agent",
    "code-intelligence",
    "graph-retrieval",
    "model-context-protocol",
    "tree-sitter",
    "sqlite",
    "token-budget",
    "codebase-memory"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Doorman11991/budget-aware-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
